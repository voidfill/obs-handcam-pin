; libobs exports used by handcam-pin. build.sh turns this into an import
; library (obs.lib) so the Windows build needs no OBS SDK. If you call a new
; libobs function, add it here (the link step will tell you which is missing).
LIBRARY obs.dll
EXPORTS
	bfree
	blog
	bmalloc
	calldata_get_data
	calldata_set_data
	dstr_copy
	dstr_ncat
	dstr_ncopy
	dstr_replace
	gs_blend_function
	gs_blend_state_pop
	gs_blend_state_push
	gs_clear
	gs_effect_create_from_file
	gs_effect_destroy
	gs_effect_get_param_by_name
	gs_effect_set_vec3
	gs_flush
	gs_ortho
	gs_stage_texture
	gs_stagesurface_create
	gs_stagesurface_destroy
	gs_stagesurface_get_height
	gs_stagesurface_get_width
	gs_stagesurface_map
	gs_stagesurface_unmap
	gs_texrender_begin
	gs_texrender_create
	gs_texrender_destroy
	gs_texrender_end
	gs_texrender_get_texture
	gs_texrender_reset
	obs_data_create
	obs_data_create_from_json_file
	obs_data_erase
	obs_data_get_bool
	obs_data_get_double
	obs_data_get_int
	obs_data_get_json
	obs_data_get_string
	obs_data_has_user_value
	obs_data_release
	obs_data_set_default_double
	obs_data_set_default_string
	obs_data_set_double
	obs_data_set_int
	obs_data_set_string
	obs_data_unset_user_value
	obs_enter_graphics
	obs_filter_get_target
	obs_find_module_file
	obs_get_frame_interval_ns
	obs_get_proc_handler
	obs_get_source_by_name
	obs_leave_graphics
	obs_module_get_config_path
	obs_module_load_locale
	obs_obj_get_data
	obs_properties_add_button
	obs_properties_add_float
	obs_properties_add_float_slider
	obs_properties_add_group
	obs_properties_add_list
	obs_properties_add_text
	obs_properties_create
	obs_properties_get
	obs_property_float_set_suffix
	obs_property_list_add_string
	obs_property_set_modified_callback
	obs_property_set_visible
	obs_register_source_s
